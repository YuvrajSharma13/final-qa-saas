# --- Core ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_qa_saas
# Long random strings in production (openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret
APP_ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase
NODE_ENV=development
# Public URL of the web app (used in notification links)
APP_URL=http://localhost:5173

# --- QA engine ---
# Path to a Chromium binary for Playwright (leave empty to use Playwright's default install)
CHROMIUM_PATH=
# Allow testing localhost / private-network apps (true for local dev, false for multi-tenant prod)
ALLOW_PRIVATE_TARGETS=true
# Allow repoUrl to be a local folder path (dev/demo only)
ALLOW_LOCAL_REPOS=true
# How many QA runs execute at the same time on this server
QA_CONCURRENCY=1

# --- AI (optional). Without a key every agent runs its deterministic engine. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Storage: local disk by default, S3-compatible when S3_BUCKET is set ---
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Notifications (optional) ---
SMTP_URL=
MAIL_FROM="AI QA <qa@example.com>"

# --- Internal orchestration endpoints (/api/agents/*). Disabled when empty. ---
INTERNAL_API_TOKEN=

# --- Optional demo target shown as a one-click option on "New project" ---
DEMO_APP_URL=http://localhost:4100/
DEMO_REPO_PATH=
